# === 千问 DashScope API(由 Hermes 平台配置 ~/.hermes/.env, 此处仅供脚本级工具参考) ===
DASHSCOPE_API_KEY=sk-xxxx

# === 数据落地(生产 VPS 上必须指向 repo 之外) ===
# EPIDEMIC_DATA_DIR=/opt/global-epidemic-ai/data
# EPIDEMIC_DB=/opt/global-epidemic-ai/database/epidemic.db

# === 抓取用 UA ===
# HTTP_USER_AGENT=GlobalEpidemicRadar/0.1 (contact: you@example.com)

# === 日报推送(push_report.py, 配哪个发哪个) ===
# WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxx
# DINGTALK_SECRET=SECxxxx           # 钉钉安全设置选"加签"时必填
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=you@qq.com
# SMTP_PASS=授权码(不是登录密码)
# SMTP_TO=leader@example.com,boss@example.com

# === 定时调度(scripts/run_scan.sh, 配合 config/crontab.example) ===
# HERMES_RUN_CMD=hermes run --prompt "{PROMPT}"    # Hermes 无头调用模板, {PROMPT} 自动替换
#                                                  # 未配置时定时任务退化为"待执行提醒"推送

# === 疫情雷达面板(webapp/app.py) ===
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8000
# RADAR_GEO=1                       # 事件坐标按国名查 OpenStreetMap; 0 关闭
# RADAR_PUBLIC_URL=http://<vps>:8000  # 推送消息里带的访问链接
# RADAR_GENERATE_CMD=               # 可选: 面板"生成日报"按钮执行的命令; 默认跑 scripts/report.py --excel --docx
