# 疫情数据不入库(生产环境在 repo 外)
data/raw/*
data/events/*
data/reports/*
!data/raw/.gitkeep
!data/events/.gitkeep
!data/reports/.gitkeep
database/
logs/
.selftest/
personal/

# 运行时产物(不入库)
# 注意: gitignore 的注释必须**独占一行** —— 行尾 `#` 会被当作模式的一部分,
# 那样规则永远匹配不到(2026-11-02 修: data/geocache.json 与
# data/ping-members.json 的规则都因行尾注释而失效, 后者一度以未跟踪文件
# 身份躺在工作区, 随时可能被 git add . 误提交)。
data/geocache.json
data/eping-members.json
scripts/_audit*.py

# Python
__pycache__/
*.pyc

# 环境变量
.env
