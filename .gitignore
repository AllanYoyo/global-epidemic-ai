# 疫情数据不入库(生产环境在 repo 外)
data/raw/*
data/events/*
data/reports/*
!data/raw/.gitkeep
!data/events/.gitkeep
!data/reports/.gitkeep
database/
logs/
.selftest/
personal/

# 运行时产物(不入库)
